[program:wholesale-whatsapp]
process_name=%(program_name)s
directory=/var/www/wholesale-order-system/current
command=/usr/bin/php8.3 artisan queue:work database --queue=whatsapp-orders,whatsapp-campaigns --sleep=3 --tries=3 --timeout=30 --backoff=30 --max-time=3600 --memory=128
user=www-data
numprocs=1
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
stopwaitsecs=120
redirect_stderr=true
stdout_logfile=/var/www/wholesale-order-system/shared/storage/logs/worker.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=5
