# Create /etc/wholesale-backup/restic.env root-owned mode0600; do not commit secrets.
# Configure this new repository with restic init exactly once, before the first backup.
RESTIC_REPOSITORY=s3:https://__BACKUP_ENDPOINT__/__BACKUP_BUCKET__/wholesale
RESTIC_PASSWORD_FILE=/etc/wholesale-backup/restic-password
BACKUP_DATABASE=__PRODUCTION_DATABASE__
AWS_ACCESS_KEY_ID=__SUPPLY_SECURELY__
AWS_SECRET_ACCESS_KEY=__SUPPLY_SECURELY__
