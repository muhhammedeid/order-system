APP_NAME="MAI SHOES"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
TRUSTED_PROXIES=

# Enable only on an isolated demonstration deployment. Automated WhatsApp is disabled.
DEMO_ENABLED=false
DEMO_ADMIN_EMAIL=admin@demo.invalid

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wholesale_order_system
DB_USERNAME=wholesale_user
DB_PASSWORD=
# Optional: CA bundle and certificate verification for a remote TLS database.
# MYSQL_ATTR_SSL_CA=
# MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Product images: use the public disk locally or r2 for object storage.
PRODUCT_IMAGES_DISK=public

# Optional Cloudflare R2 credentials (S3-compatible). Never commit values.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT=
# R2_URL=

# Staging only: idempotent admin bootstrap (php artisan staging:admin).
# STAGING_ADMIN_NAME=
# STAGING_ADMIN_EMAIL=
# STAGING_ADMIN_PASSWORD=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# WhatsApp integration. Provider: WAHA. Values are required only
# when WHATSAPP_ENABLED=true. Never commit real secrets.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=waha
WHATSAPP_DRIVER=waha
WHATSAPP_BASE_URL=http://127.0.0.1:3000
WHATSAPP_API_KEY=
WHATSAPP_SESSION=default
WHATSAPP_ORDER_LOCALE=ar
WHATSAPP_TIMEOUT=10
WHATSAPP_CONNECT_TIMEOUT=3
WHATSAPP_VERIFY_SSL=true
WHATSAPP_WEBHOOK_PATH=webhooks/whatsapp
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_WEBHOOK_TOLERANCE=300
